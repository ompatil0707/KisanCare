# KisanCare Application Configuration
# Copy this file to .env and update values with your configuration

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000
DEBUG=True

# Secret key for session management (generate a secure key)
# You can generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Weather API Configuration
# Uses Open-Meteo API (no API key needed - free and open)
# Manual OpenWeatherMap API key (optional - if you want to override Open-Meteo)
# Get free API key from https://openweathermap.org/api
# OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Database Configuration (Optional - for future use)
# SQLALCHEMY_DATABASE_URI=sqlite:///kisancare.db
# SQLALCHEMY_TRACK_MODIFICATIONS=False

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB max file size

# Model Configuration
MODEL_PATH=model/
PREDICTION_THRESHOLD=0.6

# Feature Flags
ENABLE_WEATHER_API=True
ENABLE_CROP_RECOMMENDATION=True
ENABLE_FERTILIZER_ADVICE=True
ENABLE_SCHEMES=True
ENABLE_MARKET_PRICES=True